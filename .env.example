# ── SPIKD Environment Configuration ────────────────────────────────────────────
# Copy this file to .env and fill in your values before running.
# DO NOT commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Security ────────────────────────────────────────────────────────────────────
# Generate a strong random key: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# ── Auth users ───────────────────────────────────────────────────────────────────
# JSON object: {"username": "plaintext_password", ...}
# Passwords are stored as SHA-256 hashes internally.
# Example: {"admin": "mysecurepassword", "analyst": "anotherpass"}
SPIKD_USERS={"admin":"spikd2024"}

# ── Storage ──────────────────────────────────────────────────────────────────────
SESSION_DIR=/workspace/spikd/data/sessions
ATLAS_DIR=/workspace/spikd/atlas_data

# ── Model ────────────────────────────────────────────────────────────────────────
# Directory containing tribe_v2.pt and config.json
TRIBE_MODEL_PATH=/workspace/spikd/models/tribe_v2

# ── Ollama / Llama 3.2 ───────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2

# ── VRAM (informational) ─────────────────────────────────────────────────────────
VRAM_BUDGET_MB=20000
